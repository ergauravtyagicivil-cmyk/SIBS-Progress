{
  "id": "/SIBS-Progress/app/",
  "name": "SIBS Progress Editor",
  "short_name": "SIBS Editor",
  "description": "Update SIBS microtunnel and manhole progress from your phone.",
  "start_url": "./index.html",
  "scope": "../",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F3F4F1",
  "theme_color": "#12161C",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false
}